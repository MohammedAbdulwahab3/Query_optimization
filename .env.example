# Copy to .env and adjust as needed. All values have sensible defaults.

# Backend selector: "embedded" (in-process chdb, zero dependencies) or "server".
CH_BACKEND=embedded

# --- only used when CH_BACKEND=server ---
CH_HOST=localhost
CH_PORT=8123
CH_USER=default
CH_PASSWORD=
CH_DATABASE=analytics

# --- only used when CH_BACKEND=embedded ---
CHDB_PATH=./data/chdb

# --- sample data generation ---
AUTO_SEED=true
SEED_SESSIONS=500000
SEED_USERS=50000
SEED_PRODUCTS=500
SEED_DAYS=90
